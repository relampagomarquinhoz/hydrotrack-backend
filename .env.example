# ─── Banco de Dados PostgreSQL ───────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hydrotrack
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=troque_por_uma_chave_longa_e_aleatoria_aqui
JWT_EXPIRES_IN=7d

# ─── Servidor ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Ngrok ───────────────────────────────────────────────────
# Crie conta em https://ngrok.com e cole seu token abaixo
NGROK_AUTHTOKEN=seu_token_ngrok_aqui
